        <mxCell id="n401" parent="1" style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" value="&lt;b&gt;OCP&lt;/b&gt;: implemented by constructor references&lt;br&gt;RegularCustomer::new, VIPCustomer::new,&lt;br&gt;CriticCustomer::new in ArrivalSchedule -&lt;br&gt;a new customer type needs no switch / type check." vertex="1">
          <mxGeometry height="68" width="283" x="2860" y="1520" as="geometry" />
        </mxCell>
        <mxCell id="n402" edge="1" parent="1" source="n401" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;strokeWidth=1.25;opacity=100;" target="n72">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n403" parent="1" style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" value="&lt;b&gt;DIP&lt;/b&gt;: the engine depends on the GameUI and&lt;br&gt;FoodChoiceStrategy interfaces; tests plug in&lt;br&gt;ScriptedUI / GreedyUI / FixedFoodChoice.&lt;br&gt;Rules stay in domain; UI only reads and prints." vertex="1">
          <mxGeometry height="68" width="258" x="860" y="1536" as="geometry" />
        </mxCell>
        <mxCell id="n404" edge="1" parent="1" source="n403" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;strokeWidth=1.25;opacity=100;" target="n94">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n405" parent="1" style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" value="&lt;b&gt;Polymorphism (abstract class + hooks)&lt;/b&gt;&lt;br&gt;Overridden per type, no instanceof anywhere:&lt;br&gt;getSatisfactionLossPerTurn(): 8 / 5 / 12&lt;br&gt;calculateBill(): VIPCustomer -10%&lt;br&gt;chooseDish(): CriticCustomer orders the most&lt;br&gt;expensive item (its order preference)&lt;br&gt;&lt;b&gt;Encapsulation&lt;/b&gt;: all state is private; mutators are&lt;br&gt;package-private (~) and called only by staff / Restaurant&lt;br&gt;after checking the rules (requireStatus())." vertex="1">
          <mxGeometry height="138" width="311" x="2360" y="540" as="geometry" />
        </mxCell>
        <mxCell id="n406" edge="1" parent="1" source="n405" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;strokeWidth=1.25;opacity=100;" target="n170">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n407" parent="1" style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" value="&lt;b&gt;Encapsulation&lt;/b&gt;: priceCents is final and set in the&lt;br&gt;constructor = price locked when the order is taken.&lt;br&gt;Constructor is package-private; in this implementation, Waiter creates orders." vertex="1">
          <mxGeometry height="54" width="322" x="3280" y="456" as="geometry" />
        </mxCell>
        <mxCell id="n408" edge="1" parent="1" source="n407" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;strokeWidth=1.25;opacity=100;" target="n240">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n409" parent="1" style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" value="&lt;b&gt;SRP / OCP&lt;/b&gt;: the one place a bill is computed:&lt;br&gt;customer.calculateBill() first (VIP), then every&lt;br&gt;active Promotion (Happy Hour -20%).&lt;br&gt;VIP Burger in HH: 1500 x0.9 x0.8 = 1080 cents" vertex="1">
          <mxGeometry height="68" width="261" x="3340" y="270" as="geometry" />
        </mxCell>
        <mxCell id="n410" edge="1" parent="1" source="n409" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;strokeWidth=1.25;opacity=100;" target="n273">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n411" parent="1" style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" value="&lt;b&gt;Composition&lt;/b&gt;: Restaurant creates and owns&lt;br&gt;its Tables, its staff and PricingPolicy&lt;br&gt;(Host / HappyHour only if the stage enables them).&lt;br&gt;Customers and Menu are shared (aggregation)." vertex="1">
          <mxGeometry height="68" width="281" x="787" y="110" as="geometry" />
        </mxCell>
        <mxCell id="n412" edge="1" parent="1" source="n411" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;strokeWidth=1.25;opacity=100;" target="n290">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n413" parent="1" style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" value="&lt;b&gt;Inheritance + aggregation&lt;/b&gt;: a ComboMeal IS-A&lt;br&gt;MenuItem made of two MenuItems; price = 90% of the&lt;br&gt;sum, units = sum. Order / Chef use it unchanged (LSP)." vertex="1">
          <mxGeometry height="54" width="304" x="3456" y="940" as="geometry" />
