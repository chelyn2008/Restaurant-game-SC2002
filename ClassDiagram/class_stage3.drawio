overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;fontStyle=0;" vertex="1" parent="n392"><mxGeometry x="0" y="60" width="330" height="16" as="geometry"/></mxCell><mxCell id="n395" value="- prepUnits: int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;fontStyle=0;" vertex="1" parent="n392"><mxGeometry x="0" y="74" width="330" height="16" as="geometry"/></mxCell><mxCell id="n396" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="n392"><mxGeometry x="0" y="92" width="330" height="6" as="geometry"/></mxCell><mxCell id="n397" value="+ MenuItem(name: String, priceCents: int, prepUnits: int)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;fontStyle=0;" vertex="1" parent="n392"><mxGeometry x="0" y="102" width="330" height="16" as="geometry"/></mxCell><mxCell id="n398" value="+ getName(): String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;fontStyle=0;" vertex="1" parent="n392"><mxGeometry x="0" y="116" width="330" height="16" as="geometry"/></mxCell><mxCell id="n399" value="+ getPriceCents(): int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;fontStyle=0;" vertex="1" parent="n392"><mxGeometry x="0" y="130" width="330" height="16" as="geometry"/></mxCell><mxCell id="n400" value="+ getPrepUnits(): int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;fontStyle=0;" vertex="1" parent="n392"><mxGeometry x="0" y="144" width="330" height="16" as="geometry"/></mxCell><mxCell id="n401" value="&lt;b&gt;OCP&lt;/b&gt;: implemented by constructor references&lt;br&gt;RegularCustomer::new, VIPCustomer::new,&lt;br&gt;CriticCustomer::new in ArrivalSchedule -&lt;br&gt;a new customer type needs no switch / type check." style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2860" y="1520" width="283" height="68" as="geometry"/></mxCell><mxCell id="n402" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1" source="n401" target="n72"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n403" value="&lt;b&gt;DIP&lt;/b&gt;: the engine depends on the GameUI and&lt;br&gt;FoodChoiceStrategy interfaces; tests plug in&lt;br&gt;ScriptedUI / GreedyUI / FixedFoodChoice.&lt;br&gt;Rules stay in domain; UI only reads and prints." style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="860" y="1480" width="258" height="68" as="geometry"/></mxCell><mxCell id="n404" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1" source="n403" target="n94"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n405" value="&lt;b&gt;Polymorphism (abstract class + hooks)&lt;/b&gt;&lt;br&gt;Overridden per type, no instanceof anywhere:&lt;br&gt;getSatisfactionLossPerTurn(): 8 / 5 / 12&lt;br&gt;calculateBill(): VIPCustomer -10%&lt;br&gt;chooseDish(): CriticCustomer orders the most&lt;br&gt;expensive item (its order preference)&lt;br&gt;&lt;b&gt;Encapsulation&lt;/b&gt;: all state is private; mutators are&lt;br&gt;package-private (~) and called only by staff / Restaurant&lt;br&gt;after checking the rules (requireStatus())." style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2360" y="540" width="311" height="138" as="geometry"/></mxCell><mxCell id="n406" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1" source="n405" target="n170"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n407" value="&lt;b&gt;Encapsulation&lt;/b&gt;: priceCents is final and set in the&lt;br&gt;constructor = price locked when the order is taken.&lt;br&gt;Constructor is package-private: only Waiter creates orders." style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="3280" y="456" width="322" height="54" as="geometry"/></mxCell><mxCell id="n408" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1" source="n407" target="n240"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n409" value="&lt;b&gt;SRP / OCP&lt;/b&gt;: the one place a bill is computed:&lt;br&gt;customer.calculateBill() first (VIP), then every&lt;br&gt;active Promotion (Happy Hour -20%).&lt;br&gt;VIP Burger in HH: 1500 x0.9 x0.8 = 1080 cents" style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="3340" y="270" width="261" height="68" as="geometry"/></mxCell><mxCell id="n410" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1" source="n409" target="n273"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n411" value="&lt;b&gt;Composition&lt;/b&gt;: Restaurant creates and owns&lt;br&gt;its Tables, its staff and PricingPolicy&lt;br&gt;(Host / HappyHour only if the stage enables them).&lt;br&gt;Customers and Menu are shared (aggregation)." style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="769" y="110" width="281" height="68" as="geometry"/></mxCell><mxCell id="n412" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1" source="n411" target="n290"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n413" value="&lt;b&gt;Inheritance + composition&lt;/b&gt;: a ComboMeal IS-A&lt;br&gt;MenuItem made of two MenuItems; price = 90% of the&lt;br&gt;sum, units = sum. Order / Chef use it unchanged (LSP)." style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="3490" y="780" width="304" height="54" as="geometry"/></mxCell><mxCell id="n414" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1" source="n413" target="n375"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n415" value="&amp;lt;&amp;lt;create&amp;gt;&amp;gt;" style="endArrow=open;endSize=10;dashed=1;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#000000;edgeStyle=none;exitX=0.0000;exitY=0.5189;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.8636;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n8" target="n94"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="25" y="1815"/><mxPoint x="25" y="1435"/><mxPoint x="835" y="1435"/><mxPoint x="835" y="1415