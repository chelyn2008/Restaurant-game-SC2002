flow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;fontStyle=0;" vertex="1" parent="n319"><mxGeometry x="0" y="88" width="620" height="16" as="geometry"/></mxCell><mxCell id="n323" value="+ serve(customer: Customer, turn: int): ActionResult" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;fontStyle=0;" vertex="1" parent="n319"><mxGeometry x="0" y="102" width="620" height="16" as="geometry"/></mxCell><mxCell id="n324" value="+ availableTasks(restaurant: Restaurant, turn: int): List&amp;lt;String&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;fontStyle=0;" vertex="1" parent="n319"><mxGeometry x="0" y="116" width="620" height="16" as="geometry"/></mxCell><mxCell id="n325" value="- whyCannotSeat(restaurant: Restaurant, customer: Customer): String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;fontStyle=0;" vertex="1" parent="n319"><mxGeometry x="0" y="130" width="620" height="16" as="geometry"/></mxCell><mxCell id="n326" value="- whyCannotTakeOrder(customer: Customer): String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;fontStyle=0;" vertex="1" parent="n319"><mxGeometry x="0" y="144" width="620" height="16" as="geometry"/></mxCell><mxCell id="n327" value="- whyCannotServe(customer: Customer, turn: int): String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;fontStyle=0;" vertex="1" parent="n319"><mxGeometry x="0" y="158" width="620" height="16" as="geometry"/></mxCell><mxCell id="n328" value="&lt;b&gt;OCP&lt;/b&gt;: implemented by constructor references&lt;br&gt;RegularCustomer::new, VIPCustomer::new,&lt;br&gt;CriticCustomer::new in ArrivalSchedule -&lt;br&gt;a new customer type needs no switch / type check." style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2860" y="1520" width="283" height="68" as="geometry"/></mxCell><mxCell id="n329" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1" source="n328" target="n67"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n330" value="&lt;b&gt;DIP&lt;/b&gt;: the engine depends on the GameUI and&lt;br&gt;FoodChoiceStrategy interfaces; tests plug in&lt;br&gt;ScriptedUI / GreedyUI / FixedFoodChoice.&lt;br&gt;Rules stay in domain; UI only reads and prints." style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="572" y="1130" width="258" height="68" as="geometry"/></mxCell><mxCell id="n331" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1" source="n330" target="n82"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n332" value="&lt;b&gt;Polymorphism (abstract class + hooks)&lt;/b&gt;&lt;br&gt;Overridden per type, no instanceof anywhere:&lt;br&gt;getSatisfactionLossPerTurn(): 8 / 5 / 12&lt;br&gt;calculateBill(): VIPCustomer -10%&lt;br&gt;chooseDish(): CriticCustomer orders the most&lt;br&gt;expensive item (its order preference)&lt;br&gt;&lt;b&gt;Encapsulation&lt;/b&gt;: all state is private; mutators are&lt;br&gt;package-private (~) and called only by staff / Restaurant&lt;br&gt;after checking the rules (requireStatus())." style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2420" y="526" width="311" height="138" as="geometry"/></mxCell><mxCell id="n333" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1" source="n332" target="n145"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n334" value="&lt;b&gt;Encapsulation&lt;/b&gt;: priceCents is final and set in the&lt;br&gt;constructor = price locked when the order is taken.&lt;br&gt;Constructor is package-private: only Waiter creates orders." style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="3280" y="456" width="322" height="54" as="geometry"/></mxCell><mxCell id="n335" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1" source="n334" target="n212"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n336" value="&lt;b&gt;Composition&lt;/b&gt;: Restaurant creates and owns&lt;br&gt;its Tables and its staff.&lt;br&gt;Customers and Menu are shared (aggregation)." style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="787" y="110" width="263" height="54" as="geometry"/></mxCell><mxCell id="n337" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1" source="n336" target="n251"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n338" value="&amp;lt;&amp;lt;create&amp;gt;&amp;gt;" style="endArrow=open;endSize=10;dashed=1;rounded=0;html=1;fontS