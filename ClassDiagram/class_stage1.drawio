        <mxCell id="n301" edge="1" parent="1" source="n300" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;strokeWidth=1.25;opacity=100;" target="n70">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n302" parent="1" style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" value="&lt;b&gt;Polymorphism (abstract class + hooks)&lt;/b&gt;&lt;br&gt;Engine and staff only call Customer methods;&lt;br&gt;getSatisfactionLossPerTurn() / getTypeName() are&lt;br&gt;abstract; calculateBill() is an overridable hook.&lt;br&gt;&lt;b&gt;Encapsulation&lt;/b&gt;: all state is private; mutators are&lt;br&gt;package-private (~) and called only by staff / Restaurant&lt;br&gt;after checking the rules (requireStatus())." vertex="1">
          <mxGeometry height="110" width="311" x="2000" y="730" as="geometry" />
        </mxCell>
        <mxCell id="n303" edge="1" parent="1" source="n302" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;strokeWidth=1.25;opacity=100;" target="n126">
