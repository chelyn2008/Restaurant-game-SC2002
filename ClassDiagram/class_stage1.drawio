        <mxCell id="n300" parent="1" style="shape=note;html=1;whiteSpace=wrap;size=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;" value="&lt;b&gt;DIP&lt;/b&gt;: the engine depends on the GameUI and&lt;br&gt;FoodChoiceStrategy interfaces; tests plug in&lt;br&gt;ScriptedUI / GreedyUI / FixedFoodChoice.&lt;br&gt;Rules stay in domain; UI only reads and prints." vertex="1">
          <mxGeometry height="68" width="258" x="572" y="1130" as="geometry" />
